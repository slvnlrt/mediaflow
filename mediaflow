#!/usr/bin/env python3
"""Run with `python3 mediaflow install`; no dependencies beyond Python's standard library."""
import sys

if sys.version_info < (3, 11):
    raise SystemExit("Python 3.11+ requis. Lancez bash setup.sh depuis le dossier MediaFlow.")

from mediaflow_lib.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
